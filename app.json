{
  "expo": {
    "name": "KPIManageX Arqueos",
    "slug": "kpimanagex-arqueos",
    "scheme": "kpimanagex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0E0E0E",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kpimanagex.arqueos",
      "infoPlist": {
        "NSCameraUsageDescription": "KPIManageX usa la cámara para escanear los códigos de barras durante el arqueo de inventario."
      }
    },
    "android": {
      "package": "com.kpimanagex.arqueos",
      "adaptiveIcon": {
        "backgroundColor": "#0E0E0E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-mail-composer",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "KPIManageX usa la cámara para escanear los códigos de barras durante el arqueo de inventario."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0E0E0E"
        }
      ],
      "expo-audio"
    ]
  }
}
